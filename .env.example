# Lily Cafe & Restaurant - single root environment

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:5000/api
VITE_DEV_API_TARGET=http://localhost:5000
APP_TIME_ZONE=Asia/Kathmandu
DNS_SERVERS=8.8.8.8,1.1.1.1

# MongoDB Atlas - Lily Cafe ONLY
MONGODB_URI=

# Admin authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary - Lily Cafe ONLY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lily-cafe/gallery

# Resend / email
RESEND_API_KEY=
EMAIL_FROM="Lily Cafe & Restaurant <onboarding@resend.dev>"
CONTACT_TO_EMAIL=
BRAND_LOGO_URL=
