{
  "name": "lily-cafe-fullstack",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n SERVER,CLIENT -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "nodemon --watch server --ext js,json server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "seed": "node server/scripts/seed.js",
    "seed:admin": "node server/scripts/createAdmin.js",
    "seed:gallery": "node server/scripts/seedGallery.js",
    "check:env": "node server/scripts/checkEnv.js",
    "sync:gallery": "node server/scripts/syncGalleryFromCloudinary.js"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.9.1",
    "resend": "^6.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.7"
  }
}
